{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: test",
      "type": "shell",
      "command": "python -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Backend: run",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --reload",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Issues: dry-run",
      "type": "shell",
      "command": "python scripts/create_issues.py --dry-run",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
