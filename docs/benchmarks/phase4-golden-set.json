{
  "version": "1.0.0",
  "name": "Phase 4 LLM Golden Benchmark Set",
  "description": "Fixed 20-prompt test set for on-device LLM evaluation on Samsung Galaxy Z Flip5 (SM-F731B)",
  "created_date": "2026-10-01",
  "total_prompts": 20,
  "categories": [
    "action_request",
    "conversation",
    "system_info",
    "safety_trap"
