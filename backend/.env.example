# Chọn nhà cung cấp LLM: ollama | gemini | mock
LLM_PROVIDER=ollama
PROMPT_VERSION=v1

# Ollama (chạy local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# Gemini (lấy key ở Google AI Studio). Kiểm tra tên model mới nhất trước khi dùng.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Khóa đơn giản cho mạng nội bộ (để trống = không kiểm tra)
API_KEY=

# Số tin nhắn gần nhất đưa vào ngữ cảnh
HISTORY_LIMIT=10
DB_PATH=robot.db
REQUEST_TIMEOUT=60
